{
  "name": "workbench",
  "productName": "花笺 Workbench",
  "version": "1.3.0",
  "description": "本地优先的 Windows 个人与办公工作台",
  "author": "AureliusWu",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "node scripts/smoke.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/installer-lifecycle.ps1",
    "test:updater": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/installer-lifecycle.ps1 -UseUpdater",
    "update:manifest": "node scripts/update-manifest.cjs",
    "postinstall": "node node_modules/electron/install.js",
    "test:native": "node --test scripts/native-test.cjs scripts/update-test.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "lunar-javascript": "^1.7.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "45.4.1",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "com.aureliuswu.workbench",
    "productName": "Workbench",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.png"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "guid": "01102294-7068-596a-b26b-50193e5b226e",
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "花笺 Workbench",
      "uninstallDisplayName": "花笺 Workbench",
      "packElevateHelper": false,
      "artifactName": "Workbench-Setup-${version}-win-x64.exe"
    },
    "portable": {
      "artifactName": "Workbench-Portable-${version}-win-x64.exe"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
